{
  "name": "eyfs-recovery",
  "packageManager": "yarn@4.0.2",
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --outdir=app/assets/builds",
    "build:css": "sass app/assets/stylesheets/application.scss app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps",
    "preinstall": "mkdir -p app/assets/builds",
    "copy:assets": "mkdir -p public/govuk-assets/fonts public/govuk-assets/images && cp -R node_modules/govuk-frontend/dist/govuk/assets/images/. public/govuk-assets/images && cp -R node_modules/@fortawesome/fontawesome-free/webfonts/. public/govuk-assets/fonts && sh -c 'if [ -d app/assets/fonts ]; then cp -R app/assets/fonts/. public/govuk-assets/fonts; fi'",
    "lint": "npx stylelint app/assets/stylesheets/* --fix"
  },
  "resolutions": {
    "glob": "^10.5.0",
    "tar": "7.5.19",
    "js-yaml": "4.3.0",
    "yauzl": "3.2.1",
    "immutable": "5.1.8",
    "brace-expansion": "5.0.7",
    "minimatch": "^10.2.3",
    "basic-ftp": "5.3.1",
    "flatted": "3.4.2",
    "postcss": "8.5.12"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hotwired/stimulus": "^3.2.1",
    "@hotwired/turbo-rails": "^8.0.21",
    "@stimulus-components/reveal": "^5.0.0",
    "accessible-autocomplete": "^3.0.1",
    "dfe-frontend": "^2.0.1",
    "esbuild": "^0.28.1",
    "flatted": "3.4.2",
    "govuk-frontend": "^5.11.1",
    "immutable": "^5.1.8",
    "js-yaml": "^4.3.0",
    "puppeteer": "25.2.1",
    "sass": "^1.97.2",
    "tar": "^7.5.19",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "stylelint": "^17.14.1",
    "stylelint-config-gds": "^2.0.0"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-gds/scss"
    ]
  }
}
