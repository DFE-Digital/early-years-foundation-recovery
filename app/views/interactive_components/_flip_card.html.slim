.flip-card(
  data-controller="flip-card"
  data-action="turbo:before-cache@document->flip-card#reset"
)
  .flip-card__inner data-action="click->flip-card#toggle"
    .flip-card__face.flip-card__face--front(
      data-flip-card-target="front"
      role="group"
      tabindex="-1"
      aria-labelledby="#{id}-question-heading"
      aria-describedby="#{id}-question"
    )
      .flip-card__content
        i.fa-regular.fa-lightbulb.flip-card__icon aria-hidden="true"
        .flip-card__body
          h2.govuk-heading-m id="#{id}-question-heading"
            | Question

          p.govuk-body id="#{id}-question"
            = question

      button.flip-card__button(
        type="button"
      )
        | Reveal answer
        i.fa-solid.flip-card__button__icon.fa-repeat< aria-hidden="true"

    .flip-card__face.flip-card__face--back(
      data-flip-card-target="back"
      role="group"
      tabindex="-1"
      aria-labelledby="#{id}-answer-heading"
      aria-describedby="#{id}-answer"
    )
      .flip-card__content
        i.fa-regular.fa-lightbulb.flip-card__icon aria-hidden="true"
        .flip-card__body
          h3.govuk-heading-m id="#{id}-answer-heading"
            | Answer

          p.govuk-body id="#{id}-answer"
            = answer

      button.flip-card__button(
        type="button"
      )
        | Return to question
        i.fa-solid.fa-repeat< aria-hidden="true"

  .flip-card__static.flip-card__face
    .flip-card__content
      i.fa-regular.fa-lightbulb.flip-card__icon aria-hidden="true"

      .flip-card__body
        h2.govuk-heading-m
          | Question

        p.govuk-body 
          = question

        details.govuk-details
          summary.govuk-details__summary
            span.govuk-details__summary-text
              | Reveal answer

          .govuk-details__text
            = answer

        details.govuk-details.flip-card__print-answer open=true
          summary.govuk-details__summary
            span.govuk-details__summary-text
              | Reveal answer

          .govuk-details__text
            = answer
