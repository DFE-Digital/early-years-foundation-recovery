.govuk-grid-row
  .govuk-grid-column-full
    = m('modules_title', headings_start_with: 'l')
    p.govuk-body-m = t('home.modules_summary', count: @public_modules.count)
    .govuk-grid-container
        .home-grid-container
            - if @public_modules.any?
                    - @public_modules.each do |mod|
                        = render 'home_card', mod: mod, progress: false, show_module_description: true, show_progress_description: false
            - else
                'No modules available to show at this time'
