input.menu-btn type='checkbox' id=menu_id name=menu_id checked=''
label.menu-icon.govuk-body-l for=menu_id
  svg xmlns='http://www.w3.org/2000/svg' height='1em' viewBox='0 0 448 512' aria-hidden='true' focusable='false'
    path fill='#1d70b8' d='M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z'

  = menu_label

nav.dfe-vertical-nav aria-label=navigation_label
  ul.dfe-vertical-nav__section
    - items.each do |item|
      - selected = active.eql?(item[:key])
      li.dfe-vertical-nav__section-item class=('dfe-vertical-nav__section-item--current' if selected)
        = govuk_link_to item[:text], item[:href],
          class: 'dfe-vertical-nav__link',
          aria: { current: selected ? 'page' : nil }